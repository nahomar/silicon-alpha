[Unit]
Description=silicon-alpha: CHOKEPOINT market + supply recorder
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=silicon
WorkingDirectory=/home/silicon/projects/silicon-alpha
Environment=PYTHONPATH=/home/silicon/projects/silicon-alpha
Environment=REPO=/home/silicon/projects/silicon-alpha
Environment=PY=/home/silicon/projects/silicon-alpha/.venv-live/bin/python
EnvironmentFile=-/home/silicon/.config/silicon-alpha/server.env
ExecStart=/home/silicon/projects/silicon-alpha/chokepoint/record/snapshot.sh
TimeoutStartSec=1h
StandardOutput=append:/home/silicon/projects/silicon-alpha/data/live/logs/chokepoint.out
StandardError=append:/home/silicon/projects/silicon-alpha/data/live/logs/chokepoint.err
